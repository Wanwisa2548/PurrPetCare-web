# ===== คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง =====

# ชื่อเครื่อง SQL Server (ส่วนหน้าของ Server name ใน SSMS)
DB_SERVER=localhost

# ถ้าใน SSMS ต่อด้วย "localhost\SQLEXPRESS" ให้ใส่ SQLEXPRESS
# ถ้าต่อด้วย "localhost" หรือ "." เฉยๆ ให้เว้นว่างไว้ (default instance ชื่อ MSSQLSERVER)
# ดูชื่อ instance ที่มีในเครื่องได้จาก SQL Server Configuration Manager → SQL Server Services
# ถ้าใส่ SQLEXPRESS แต่เครื่องไม่มี instance นี้ จะขึ้น "Port for SQLEXPRESS not found"
DB_INSTANCE=SQLEXPRESS

# ถ้ารู้ port (เช่น 1433) ใส่ตรงนี้ได้ แล้วเว้น DB_INSTANCE ว่าง
DB_PORT=

DB_NAME=PurrPetCare

# บัญชี SQL Server Authentication (ต้องเปิด Mixed Mode ก่อน ดู README)
# แนะนำใช้ purrpet_web ที่สร้างจากไฟล์ database/PurrPetCare_WebLogin.sql
DB_USER=purrpet_web
DB_PASSWORD=PurrPet@2026

# รหัสผ่านเข้าหน้า Admin
ADMIN_PASSWORD=admin1234

SESSION_SECRET=change-this-to-any-long-random-text
PORT=3000
